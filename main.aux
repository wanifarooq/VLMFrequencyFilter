\newlabel{fig:forest}{{1}{7}{Forest plot of the tug-of-war (100-sample 8B, primary target log-likelihood volatility). Pooled OLS (circles) and within-image fixed effects (squares) both give $\tilde \beta (\Cres )>0$ (destabilises) and $\tilde \beta (\Cprompt )<0$ (stabilises). 1000-image 2B run gives larger magnitudes ($+0.29 / -0.32$, $R^2 = 0.22$, $p < 10^{-130}$ / $p < 10^{-209}$)}{figure.caption.14}{}}
\newlabel{fig:forest@cref}{{[figure][1][]1}{[1][7][]7}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Layer-resolved bandwidth $G(t)$ across all 36 decoder attention layers (8B, 100 samples). Solid: primaries L1--L4. Dashed: wordy mirrors L5--L8. Vertical dashed lines mark layer-group thirds. The four stages of the trajectory are visible: a sharp layer-0 length prior (wordy below primary by $-0.74$), erasure by layer 2, length-insensitive content narrowing through mid, and a re-opened wordy-broader gap peaking at $+0.33$ at layer 31.}}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:bandwidth_vs_csem}{{2}{7}{Layer-resolved bandwidth $\Gt $ across all 36 decoder attention layers (8B, 100 samples). Solid: primaries L1--L4. Dashed: wordy mirrors L5--L8. Vertical dashed lines mark layer-group thirds. The four stages of the trajectory are visible: a sharp layer-0 length prior (wordy below primary by $-0.74$), erasure by layer 2, length-insensitive content narrowing through mid, and a re-opened wordy-broader gap peaking at $+0.33$ at layer 31}{figure.caption.15}{}}
\newlabel{fig:bandwidth_vs_csem@cref}{{[figure][2][]2}{[1][7][]7}}

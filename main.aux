\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Mean log-likelihood volatility per $(\Delta F, W_t(\omega ))$ cell, image-space last\_2, all four runs. Narrow $W_t(\omega )$ is higher than broadband in $4/4$ rows on CLEVR-2B and GQA-8B. On CLEVR-8B all four rows reverse because broadband-$W_t(\omega )$ cells there are overwhelmingly wordy mirrors near the log-prob ceiling, exhibiting large absolute swings from having more room to fall (the recovery-dominance regime of \S  \ref {sec:confounds}). On GQA-2B per-row differences are within $\pm 0.11$ (sampling noise). The mechanism reads: narrow $W_t(\omega )$ amplifies drift \emph  {on top of} whatever ceiling-dynamics the model is in.}}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:signature_grid}{{2}{7}{Mean log-likelihood volatility per $(\Delta F, \Wt )$ cell, image-space last\_2, all four runs. Narrow $\Wt $ is higher than broadband in $4/4$ rows on CLEVR-2B and GQA-8B. On CLEVR-8B all four rows reverse because broadband-$\Wt $ cells there are overwhelmingly wordy mirrors near the log-prob ceiling, exhibiting large absolute swings from having more room to fall (the recovery-dominance regime of \S \ref {sec:confounds}). On GQA-2B per-row differences are within $\pm 0.11$ (sampling noise). The mechanism reads: narrow $\Wt $ amplifies drift \emph {on top of} whatever ceiling-dynamics the model is in}{figure.caption.15}{}}
